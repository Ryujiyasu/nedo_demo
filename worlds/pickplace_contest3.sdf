<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="pickplace_world">

    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.35 0.35 0.4</ambient_light>
        <background_color>0.05 0.06 0.09</background_color>
        <camera_pose>2.2 -1.8 1.6 0 0.32 2.30</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="InteractiveViewControl" name="Interactive view control"/>
    </gui>

    <scene>
      <ambient>0.32 0.33 0.38 1.0</ambient>
      <background>0.05 0.06 0.10 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
      <sky/>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>2 -2 6 0 0.7 0.6</pose>
      <diffuse>1.0 0.97 0.92 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>50</range>
        <constant>0.9</constant>
        <linear>0.005</linear>
        <quadratic>0.0001</quadratic>
      </attenuation>
      <direction>-0.4 0.3 -1.0</direction>
    </light>
    <light type="point" name="fill_left">
      <pose>-1.5 1.5 2 0 0 0</pose>
      <diffuse>0.40 0.50 0.70 1</diffuse>
      <specular>0.1 0.1 0.2 1</specular>
      <attenuation>
        <range>12</range>
        <constant>0.4</constant>
        <linear>0.05</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>
    <light type="spot" name="arm_key">
      <pose>1.0 0 3.0 0 1.4 0</pose>
      <diffuse>0.9 0.92 1.0 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>8</range>
        <constant>0.5</constant>
        <linear>0.05</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0 0 -1</direction>
      <spot>
        <inner_angle>0.6</inner_angle>
        <outer_angle>1.1</outer_angle>
        <falloff>1.0</falloff>
      </spot>
    </light>

    <!-- Floor -->
    <model name="floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.10 0.11 0.13 1</ambient>
            <diffuse>0.18 0.19 0.22 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Short BHS feed conveyor -->
    <model name="bhs_conveyor">
      <static>true</static>
      <pose>0.7 0 0.50 0 0 0</pose>
      <link name="belt">
        <collision name="belt_col">
          <geometry><box><size>1.2 0.6 0.08</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.6</mu>
                <mu2>0.6</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="belt_vis">
          <geometry><box><size>1.2 0.6 0.08</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.10 1</ambient>
            <diffuse>0.16 0.16 0.18 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
      </link>
      <link name="rail_l">
        <pose>0 0.32 0.06 0 0 0</pose>
        <visual name="vis"><geometry><box><size>1.2 0.05 0.20</size></box></geometry>
          <material><ambient>0.30 0.30 0.35 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material></visual>
        <collision name="col"><geometry><box><size>1.2 0.05 0.20</size></box></geometry></collision>
      </link>
      <link name="rail_r">
        <pose>0 -0.32 0.06 0 0 0</pose>
        <visual name="vis"><geometry><box><size>1.2 0.05 0.20</size></box></geometry>
          <material><ambient>0.30 0.30 0.35 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material></visual>
        <collision name="col"><geometry><box><size>1.2 0.05 0.20</size></box></geometry></collision>
      </link>
      <link name="leg_a">
        <pose>-0.5 0 -0.27 0 0 0</pose>
        <visual name="vis"><geometry><box><size>0.10 0.6 0.50</size></box></geometry>
          <material><ambient>0.30 0.30 0.35 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material></visual>
      </link>
      <link name="leg_b">
        <pose>0.5 0 -0.27 0 0 0</pose>
        <visual name="vis"><geometry><box><size>0.10 0.6 0.50</size></box></geometry>
          <material><ambient>0.30 0.30 0.35 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ULD bin (placement target), close to arm for Piper reach -->
    <model name="uld_ld3">
      <static>true</static>
      <pose>0 -0.55 0.18 0 0 0</pose>
      <link name="base">
        <visual name="vis"><geometry><box><size>0.7 0.7 0.04</size></box></geometry>
          <material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.55 0.56 0.60 1</diffuse><specular>0.5 0.5 0.5 1</specular></material></visual>
        <collision name="col"><geometry><box><size>0.7 0.7 0.04</size></box></geometry></collision>
      </link>
      <link name="wall_back">
        <pose>-0.32 0 0.25 0 0 0</pose>
        <visual name="vis"><geometry><box><size>0.05 0.7 0.50</size></box></geometry>
          <material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.55 0.56 0.60 1</diffuse></material></visual>
        <collision name="col"><geometry><box><size>0.05 0.7 0.50</size></box></geometry></collision>
      </link>
      <link name="wall_front">
        <pose>0.32 0 0.25 0 0 0</pose>
        <visual name="vis"><geometry><box><size>0.05 0.7 0.50</size></box></geometry>
          <material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.55 0.56 0.60 1</diffuse></material></visual>
        <collision name="col"><geometry><box><size>0.05 0.7 0.50</size></box></geometry></collision>
      </link>
      <link name="wall_l">
        <pose>0 -0.32 0.25 0 0 0</pose>
        <visual name="vis"><geometry><box><size>0.7 0.05 0.50</size></box></geometry>
          <material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.55 0.56 0.60 1</diffuse></material></visual>
        <collision name="col"><geometry><box><size>0.7 0.05 0.50</size></box></geometry></collision>
      </link>
    </model>

    <!-- Cinematic camera (high 3/4 view showing arm, conveyor, ULD all in frame) -->
    <model name="cinematic_cam">
      <static>true</static>
      <pose>2.3 -1.8 1.9 0 0.45 2.40</pose>
      <link name="cam_link">
        <sensor name="cinematic" type="camera">
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.20</horizontal_fov>
            <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>100</far></clip>
          </camera>
          <topic>cinematic</topic>
          <always_on>true</always_on>
          <plugin filename="gz-sim-camera-video-recorder-system"
                  name="gz::sim::systems::CameraVideoRecorder">
            <service>cinematic/record_video</service>
            <use_sim_time>true</use_sim_time>
          </plugin>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
